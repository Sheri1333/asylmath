# Frontend: leave empty so Vite proxy / same-origin works
VITE_API_URL=

# Backend (also copy into server/.env)
HOST=127.0.0.1
PORT=3001
JWT_SECRET=change-me-in-production
MONGODB_URI=mongodb://127.0.0.1:27017/aslmath
CORS_ORIGIN=http://localhost:5173

# Telegram bot for Kaspi payment checks (put the real token only in server/.env on the VPS).
TELEGRAM_BOT_TOKEN=
# Only one admin can use the bot. Either pin your Telegram user id here...
TELEGRAM_ADMIN_ID=
# ...or send `/start <this code>` to the bot once; after that the bot is locked to your chat.
TELEGRAM_BIND_CODE=
